# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Painel do Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# Pode ser a "anon public key" ou a nova "publishable key"
VITE_SUPABASE_ANON_KEY=sua-chave-publica-aqui

# Formulário de contato: chave do web3forms.com (envia as mensagens para o seu e-mail)
VITE_WEB3FORMS_KEY=sua-chave-do-web3forms
